#ifndef COURSE_ROUTE_H
#define COURSE_ROUTE_H
#define COURSE_ROUTE_START_X_MM 420
#define COURSE_FIXED_LINE_TEST 1

/* Set to 1 to fly the A* shortest path from Tools/plan_route.py instead of the
 * hand-tuned curve below. Both tables are measured with the same obstacle table
 * the MCU uses (grid_static_obstacles[18]):
 *   planned  : 94 points, 2392.3 mm, min clearance 1.4 mm at 52 mm inflation
 *   hand-tuned: 73 points, 2521.6 mm (with the start entry), 0 collisions at
 *               45 mm and 52 mm inflation (clearance to the inflated edge 23.7
 *               and 13.8 mm); real clearance to the boxes: T11 87.1 mm,
 *               T14 108.2 mm, T9 94.8 mm, T15 154.0 mm, U 75.0 mm
 * The tuned curve is ~134 mm longer but much safer, so the A* route stays
 * opt-in until it has been driven on the car.
 *
 * 2026-11-22 final-leg change: the whole descent moved from X = 1302 mm to
 * X = 1275 mm so the 90 mm body keeps 80 mm to T15/T16 instead of 53 mm. The
 * finish corridor is only 1200..1400 mm wide (U block edge to T15 edge), so a
 * 90 mm body leaves 110 mm of legal centre travel: 1245..1355 mm. X = 1275 mm
 * leaves 30 mm body edge to the U block and 80 mm to T15; a 70 mm shift would
 * put the body 13 mm inside the U block, so 27 mm is the practical limit.
 * At the 64 mm full half-diagonal inflation one segment in the T9/T11 gap still
 * clips the inflated T11 corner; the 45 mm (real half-width) test is clean.
 * Flash cost: the hand-tuned table is stored in centimetres (2 B per point, see
 * below), so 71 points cost 142 B; the planned 94-point table costs 94 * 6 =
 * 564 B, i.e. +422 B over the compressed hand-tuned table. */
#define COURSE_ROUTE_USE_PLANNED 0

#if COURSE_ROUTE_USE_PLANNED
#include "course_route_planned.h"
#define course_route course_route_planned
#else
